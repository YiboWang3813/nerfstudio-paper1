@inproceedings{niedermayrCompressed3DGaussian2024,
  title = {Compressed {{3D Gaussian Splatting}} for {{Accelerated Novel View Synthesis}}},
  booktitle = PROC_CVPR,
  author = {Niedermayr, Simon and Stumpfegger, Josef and Westermann, R{\"u}diger},
