@article{songUniqueSplatViewConditioned3D2025,
  title = {{{UniqueSplat}}: {{View-Conditioned 3D Gaussian Splatting}} for {{Generalizable 3D Reconstruction}}},
  shorttitle = {{{UniqueSplat}}},
  author = {Song, Haixu and Yang, Xiaoke and Zhang, Shengjun and Lu, Jiwen and Duan, Yueqi},
  year = 2025,
  journal = IEEE_J_IP,
  volume = {34},
  pages = {8376--8389},
  issn = {1941-0042},
  doi = {10.1109/TIP.2025.3642574},
  urldate = {2026-06-14},
  abstract = {In this paper, we propose UniqueSplat, a view-conditioned feed-forward 3D Gaussian Splatting model to reconstruct customized 3D radiance fields for each view query. Existing feed-forward methods such as pixelSplat and MVSplat aim to generate fixed Gaussians across all views of each scene by minimizing the error between rendered views and ground-truth images. However, such fixed Gaussians generally render images from all views and lack the ability to adapt to specific viewpoints, as they do not incorporate target view information when predicting Gaussians. To address this, our UniqueSplat learns the view-conditioned information as a prior and incorporates this knowledge into network parameters, so that Gaussians are dynamically adjusted in accordance with different views. Specifically, we propose a two-branch view-conditioned hyperNetwork to simultaneously learn view-agnostic embeddings and view-specific knowledge, which not only explores the shareable knowledge from various views, but also adapts the model to specific views at test time. Extensive experiments on widely-used datasets including RealEstate10K, ACID and DTU demonstrate the superiority of UniqueSplat over the state-of-the-art methods. Moreover, UniqueSplat encouragingly outperforms existing methods in cross-dataset evaluation, showing its notable generalization ability.},
  keywords = {Adaptation models,Costs,Feature extraction,Feed-forward 3D Gaussian Splatting,generalizable novel view synthesis,Image reconstruction,Predictive models,Real-time systems,Rendering (computer graphics),Solid modeling,sparse-view,Three-dimensional displays,Training,view-conditioned},
  file = {/Users/wangyibo/Zotero/storage/S9D8NRXY/Song 等 - 2025 - UniqueSplat View-Conditioned 3D Gaussian Splatting for Generalizable 3D Reconstruction.pdf}
}

@article{wangPhysicallyPlausibleHuman2026,
  title = {Physically {{Plausible Human}}--{{Object Rendering From Sparse Views}} via {{3D Gaussian Splatting}}},
  author = {Wang, Weiquan and Xiao, Jun and Yang, Yi and Zhuang, Yueting and Chen, Long},
  year = 2026,
  journal = IEEE_J_IP,
  volume = {35},
  pages = {3938--3953},
  issn = {1941-0042},
  doi = {10.1109/TIP.2026.3682124},
  urldate = {2026-06-14},
  abstract = {Rendering realistic human-object interactions (HOIs) from sparse-view inputs is a challenging yet crucial task for various real-world applications. Existing methods often struggle to simultaneously achieve high rendering quality, physical plausibility, and computational efficiency. To address these limitations, we propose HOGS (Human-Object Rendering via 3D Gaussian Splatting), a novel framework for efficient HOI rendering with physically plausible geometric constraints from sparse views. HOGS represents both humans and objects as dynamic 3D Gaussians. Central to HOGS is a novel optimization process that operates directly on these Gaussians to enforce geometric consistency (i.e., preventing inter-penetration or floating contacts) to achieve physical plausibility. To support this core optimization under sparse-view ambiguity, our framework incorporates two pre-trained modules: an optimization-guided Human Pose Refiner for robust estimation under sparse-view occlusions, and a Human-Object Contact Predictor that efficiently identifies interaction regions to guide our novel contact and separation losses. Extensive experiments on both human-object and hand-object interaction datasets demonstrate that HOGS achieves state-of-the-art rendering quality and maintains high computational efficiency.},
  keywords = {3D Gaussian splatting,Activity recognition,Avatars,Circuits and systems,Communications technology,Contacts,Filtering,Filters,Graphical user interfaces,Human activity recognition,Human-object interactions,Modulation,physically plausible optimization,sparse-view rendering},
  file = {/Users/wangyibo/Zotero/storage/3EYHGB6M/Wang 等 - 2026 - Physically Plausible Human–Object Rendering From Sparse Views via 3D Gaussian Splatting.pdf}
}

