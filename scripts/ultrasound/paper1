#!/usr/bin/env bash
set -euo pipefail
paper1_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
export CUDA_HOME=/usr/local/cuda-12.4
export PATH="$paper1_root/.venv/bin:/home/yibo/shared/envs/torch251-cu124-py311/bin:$CUDA_HOME/bin:/usr/bin:/bin"
export CC=/usr/bin/gcc CXX=/usr/bin/g++
export TORCH_CUDA_ARCH_LIST=8.9
export MAX_JOBS="${MAX_JOBS:-2}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
