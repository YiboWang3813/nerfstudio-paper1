__pycache__/
*.py[cod]
.DS_Store

# Figure/table projects retain configs, small numeric inputs and provenance.
# Heavy reference assets and bulk exports stay local; these are precise paths.
/experiments/*/assets/
/experiments/*/exports/
/experiments/*/.cache/

# Local literature payloads; bibliography/hash index remains versioned.
/resources/papers/*.pdf
/resources/research-notes/*.zip

# Locally retained detailed receipts, logs and source inventories.
/resources/maintenance-assets/
/resources/history/

# Canonical manuscript author PDFs and local TeX compilation products.
/manuscript/figures/pdf/
/manuscript/build/
/manuscript/dist/
