@inproceedings{eidRapidvolRapidReconstruction2025,
  title = {Rapidvol: {{Rapid Reconstruction}} of {{3D Ultrasound Volumes}} from {{Sensorless 2D Scans}}},
  shorttitle = {Rapidvol},
  booktitle = PROC_ISBI,
  author = {Eid, Mark C. and Yeung, Pak-Hei and Wyburd, Madeleine K. and Henriques, Jo{\~a}o F. and Namburete, Ana I.L.},
  year = 2025,
  month = apr,
  pages = {1--5},
  issn = {1945-8452},
  doi = {10.1109/ISBI60581.2025.10980994},
  urldate = {2025-09-06},
  abstract = {Two-dimensional (2D) freehand ultrasonography is a widely used medical imaging modality, particularly in obstetrics and gynaecology. However, it only captures 2D cross-sectional views of inherently 3D anatomies, losing valuable contextual information. As an alternative to costly 3D ultrasound (US) scanners, 3D volumes can be artificially reconstructed from 2D scans, but this is usually prohibitively slow. Hence, we propose RapidVol: a neural representation framework to speed up slice-to-volume US reconstruction. We use tensor-rank decomposition to decompose the typical 3D volume into tri-planes, which are stored alongside a small neural network. With a set of 2D US scans and their estimated 3D orientation, RapidVol can achieve complete 3D reconstruction. To evaluate our method, we form reconstructions from real fetal brain scans, and then request novel cross-sectional views. Compared to prior fully implicit (e.g. neural radiance field) approaches, our method is over 3x quicker, 46\% more accurate, and more robust to errors in pose estimation. We also demonstrate that further speed-up is achievable by reconstructing from a structural prior rather than from random initialisation.},
  keywords = {3D Reconstruction,Accuracy,Biomedical imaging,Image reconstruction,NeRF,Neural radiance field,Obstetrics,Pose estimation,Probes,Three-dimensional displays,Two-dimensional displays,Ultrasonography,Ultrasound},
  file = {/Users/wangyibo/Zotero/storage/59PCUGW4/Eid 等 - 2025 - Rapidvol Rapid Reconstruction of 3D Ultrasound Volumes from Sensorless 2D Scans.pdf}
}

@inproceedings{douContinuousBernoulliDistribution2024,
  title = {Continuous {{Bernoulli Distribution}} for {{More Realistic Ultrasound Reconstruction}} with {{NeRF}}},
  booktitle = PROC_UFFCJS,
  author = {Dou, Yimeng and Varghese, Tomy},
  year = 2024,
  pages = {1--4},
  issn = {2375-0448},
  doi = {10.1109/UFFC-JS60046.2024.10793769},
  urldate = {2025-09-03},
  abstract = {Three-dimensional visualization offers a significantly improved depiction of the underlying anatomical structure; however conventional ultrasound typically provides two-dimensional B-mode images of anatomical regions in real time. Recent breakthroughs in computer graphics have leveraged the ability of Neural Radiance Fields (NeRF) to reconstruct three-dimensional scenes implicitly. This is achieved by formulating the three-dimensional scenes as continuous signals using multi-layer perception (MLP). The reconstructed images can be viewed from novel perspectives using a differentiable rendering method. However, current methods cannot recover complex ultrasound anatomical structures and can introduce artifacts, which impact the reconstruction quality. We propose a probabilistic and differentiable approach to estimate backscattered data to provide a more realistic three-dimensional ultrasound reconstruction with NeRF. Our proposed method achieves an improved peak signal-to-noise ratio (PSNR) score of 27.73\textpm 0.98 dB compared to the baseline method with 26.31\textpm 1.91 dB, along with an improved structural similarity index measure (SSIM) value of 0.47\textpm 0.21 to 0.54\textpm 0.19 for NeRF.},
  keywords = {Anatomical structure,Freehand Ultrasound,Image reconstruction,Indexes,Neural radiance field,Probabilistic logic,PSNR,Real-time systems,Rendering (computer graphics),Three-dimensional reconstruction,Ultrasonic imaging,Ultrasonic variables measurement},
  file = {/Users/wangyibo/Zotero/storage/2Y66CL34/Dou和Varghese - 2024 - Continuous Bernoulli Distribution for More Realistic Ultrasound Reconstruction with NeRF.pdf}
}

